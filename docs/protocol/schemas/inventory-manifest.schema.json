{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:depverify:protocol:v1:inventory-manifest",
  "title": "POST /agent/v1/inventories — manifest (protocol.md §8.2)",
  "type": "object",
  "required": ["protocol_version", "inventory_id", "trigger", "started_at", "completed_at", "host_facts", "subjects"],
  "additionalProperties": false,
  "properties": {
    "protocol_version": { "$ref": "urn:depverify:protocol:v1:common#/$defs/protocolVersion" },
    "inventory_id": { "$ref": "urn:depverify:protocol:v1:common#/$defs/uuid7" },
    "trigger": { "enum": ["scheduled", "scan_now", "image_change", "startup"] },
    "started_at": { "$ref": "urn:depverify:protocol:v1:common#/$defs/timestamp" },
    "completed_at": { "$ref": "urn:depverify:protocol:v1:common#/$defs/timestamp" },
    "host_facts": {
      "allOf": [
        { "$ref": "urn:depverify:protocol:v1:common#/$defs/snapshotRef" },
        { "properties": { "media_type": { "const": "application/vnd.depverify.host-facts+json;version=1" } } }
      ]
    },
    "subjects": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["subject_key", "kind", "sbom"],
        "properties": {
          "subject_key": { "type": "string", "pattern": "^(host|(path|compose|container|image):.+)$", "maxLength": 4200 },
          "kind": { "enum": ["path", "compose_service", "container", "container_image", "host"] },
          "sbom": {
            "allOf": [
              { "$ref": "urn:depverify:protocol:v1:common#/$defs/snapshotRef" },
              { "properties": { "media_type": { "const": "application/vnd.cyclonedx+json;version=1.6" } } }
            ]
          }
        },
        "oneOf": [
          { "$ref": "#/$defs/pathSubject" },
          { "$ref": "#/$defs/composeServiceSubject" },
          { "$ref": "#/$defs/containerSubject" },
          { "$ref": "#/$defs/containerImageSubject" },
          { "$ref": "#/$defs/hostSubject" }
        ]
      }
    }
  },
  "$defs": {
    "imageId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "pathSubject": {
      "type": "object",
      "required": ["kind", "path", "origin"],
      "additionalProperties": false,
      "properties": {
        "subject_key": { "type": "string", "pattern": "^path:/" },
        "kind": { "const": "path" },
        "sbom": true,
        "path": { "$ref": "urn:depverify:protocol:v1:common#/$defs/absolutePath" },
        "origin": { "enum": ["discovered", "declared"] },
        "runtime": {
          "type": "object",
          "required": ["name", "version"],
          "additionalProperties": false,
          "properties": {
            "name": { "enum": ["php", "node"] },
            "version": { "type": "string" },
            "service": { "type": "string", "description": "Serving process, e.g. php8.2-fpm." }
          }
        }
      }
    },
    "composeServiceSubject": {
      "type": "object",
      "required": ["kind", "compose_project", "service", "container_ids", "image_id"],
      "additionalProperties": false,
      "properties": {
        "subject_key": { "type": "string", "pattern": "^compose:[^/]+/.+$" },
        "kind": { "const": "compose_service" },
        "sbom": true,
        "compose_project": { "type": "string", "minLength": 1 },
        "service": { "type": "string", "minLength": 1 },
        "container_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
        "image_id": { "$ref": "#/$defs/imageId" },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "environment": { "$ref": "urn:depverify:protocol:v1:common#/$defs/uuid7" },
            "paths": { "type": "array", "items": { "$ref": "urn:depverify:protocol:v1:common#/$defs/absolutePath" } }
          }
        }
      }
    },
    "containerSubject": {
      "type": "object",
      "required": ["kind", "container_name", "container_id", "image_id"],
      "additionalProperties": false,
      "properties": {
        "subject_key": { "type": "string", "pattern": "^container:.+$" },
        "kind": { "const": "container" },
        "sbom": true,
        "container_name": { "type": "string", "minLength": 1 },
        "container_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "image_id": { "$ref": "#/$defs/imageId" }
      }
    },
    "containerImageSubject": {
      "type": "object",
      "required": ["kind", "image_id", "repo_digests", "tags", "provenance"],
      "additionalProperties": false,
      "properties": {
        "subject_key": { "type": "string", "pattern": "^image:sha256:[0-9a-f]{64}$" },
        "kind": { "const": "container_image" },
        "sbom": true,
        "image_id": { "$ref": "#/$defs/imageId" },
        "repo_digests": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "provenance": { "enum": ["registry", "local-build"] },
        "base_image": { "type": "string" }
      }
    },
    "hostSubject": {
      "type": "object",
      "description": "The OS packages of the host itself (dpkg, rpm, apk). Sent only by an agent that sees the host: mode host, or container with scope host.",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "subject_key": { "const": "host" },
        "kind": { "const": "host" },
        "sbom": true
      }
    }
  }
}
